# Copiar a .env y rellenar. El .env no se versiona.

# --- Base de datos MySQL ---
# El esquema se aplica a mano: no hay migraciones en el repo.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
# Secreto para firmar el JWT. Cambiarlo invalida todos los tokens emitidos.
JWT_SECRET=

# --- Servidor ---
# Puerto HTTP. Por defecto 4000 si no se define.
PORT=4000

# --- Entorno ---
# Unico uso hoy: apagar Swagger. Con NODE_ENV=production, /docs y /docs-json
# devuelven 404; con cualquier otro valor, o sin definir, la UI se monta.
# La UI de Swagger NO pasa por el JwtAuthGuard, asi que en un despliegue
# publico esta variable tiene que valer production.
NODE_ENV=development
