# Copiar a .env y rellenar. El .env no se versiona.

# --- Base de datos MySQL ---
# El esquema se aplica a mano: no hay migraciones en el repo.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
# Secreto para firmar el JWT. Cambiarlo invalida todos los tokens emitidos.
JWT_SECRET=

# --- Servidor ---
# Puerto HTTP. Por defecto 4000 si no se define.
PORT=4000

# --- IA (SPEC 27) ---
# Solo la usa POST /lotes/{id}/resumen, que manda las metricas de un lote
# finalizado a Gemini y guarda el markdown que devuelve en lotes.resumen_ia.
#
# GEMINI_API_KEY es OBLIGATORIA para esa ruta: sin ella responde 503. El
# arranque de la aplicacion NO falla, para no romper los ambientes que no
# usan la funcion. Se saca de https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3.1-flash-lite. Cambiar de modelo es editar
# esta linea, no desplegar.
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcional. Por defecto 45000. Acota cuanto retiene la peticion la unica
# conexion del pool que abre DatabaseMiddleware. Medido en el paso 6 del
# SPEC 27: las llamadas que funcionan tardan de 1 a 18 segundos, asi que con
# 20000 se perdian respuestas buenas.
GEMINI_TIMEOUT_MS=45000

# --- Entorno ---
# Unico uso hoy: apagar Swagger. Con NODE_ENV=production, /docs y /docs-json
# devuelven 404; con cualquier otro valor, o sin definir, la UI se monta.
# La UI de Swagger NO pasa por el JwtAuthGuard, asi que en un despliegue
# publico esta variable tiene que valer production.
NODE_ENV=development
