# Plantilla del /opt/<slug>/.env de cada tenant. nuevo-tenant.sh la copia y
# rellena TENANT, DOMAIN, DB_* y JWT_SECRET; el resto (Gemini) se completa a
# mano. Nunca se versiona el archivo rellenado.

# --- Tenant ---
# Slug: minusculas y numeros. Da el nombre del contenedor (api-<slug>), de la
# base (agro_<slug>) y del usuario MySQL (agro_<slug>).
TENANT=
# Solo informativo aqui: quien enruta el dominio es tenants/<slug>.caddy en
# la plataforma.
DOMAIN=

# --- Imagen ---
# latest, o un tag sha-xxxxxxx para fijar/volver a una version exacta en este
# tenant sin tocar a los demas.
API_IMAGE=ghcr.io/jesus180reyes/core-control-calidad-agro-backend:latest

# --- MySQL ---
# Usuario propio del tenant, con permisos solo sobre su base: si este .env se
# filtra, no da acceso a las bases de los demas tenants.
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Auth ---
# Uno por tenant: un token de un tenant no sirve en otro. Cambiarlo invalida
# todos los tokens emitidos.
JWT_SECRET=
PASSWORD_VIGENCIA_DIAS=90

# --- IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_CHAT_MODEL=
CHAT_LIMITE_DIARIO=20

# --- Entorno ---
# Vacio = production. development monta Swagger en /docs, abierto sin token:
# SOLO en dev. NODE_ENV en este archivo se ignora (lo fija el compose).
API_NODE_ENV=

# NODE_ENV, DB_HOST, DB_PORT y PORT los fija docker-compose.yml.
