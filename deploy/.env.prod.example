# Copiar a /opt/agro/.env en el servidor y rellenar. Nunca se versiona.
# Generar secretos con:  openssl rand -base64 48

# --- Dominio (Caddy) ---
DOMAIN=api.tudominio.com

# --- Imagen ---
# latest, o un tag sha-xxxxxxx para fijar/volver a una version exacta.
API_IMAGE=ghcr.io/jesus180reyes/core-control-calidad-agro-backend:latest

# --- MySQL ---
DB_NAME=agro
DB_USER=agro_app
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Auth ---
# Distinto al de desarrollo. Cambiarlo invalida todos los tokens emitidos.
JWT_SECRET=
PASSWORD_VIGENCIA_DIAS=90

# --- IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_CHAT_MODEL=
CHAT_LIMITE_DIARIO=20

# NODE_ENV, DB_HOST, DB_PORT y PORT los fija docker-compose.prod.yml.
