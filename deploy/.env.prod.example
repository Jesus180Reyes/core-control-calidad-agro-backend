# Copiar a /opt/agro/.env en el servidor y rellenar. Nunca se versiona.
# Generar secretos con:  openssl rand -base64 48

# --- Dominio (Caddy) ---
DOMAIN=api.tudominio.com

# --- Dozzle (logs, via Caddy con basic_auth) ---
# Otro subdominio con su propio registro A (con sslip.io no hace falta DNS).
DOZZLE_DOMAIN=logs.tudominio.com
DOZZLE_USER=admin
# Hash bcrypt de "caddy hash-password". Entre comillas SIMPLES: lleva "$" y
# sin ellas Compose lo interpreta como variables y el login nunca pasa.
DOZZLE_PASSWORD_HASH=''

# --- Imagen ---
# latest, o un tag sha-xxxxxxx para fijar/volver a una version exacta.
API_IMAGE=ghcr.io/jesus180reyes/core-control-calidad-agro-backend:latest

# --- MySQL ---
DB_NAME=agro
DB_USER=agro_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Vacio = MySQL solo en el localhost del servidor (produccion).
# 0.0.0.0 = abierto a internet para conectarse con Workbench: SOLO en dev,
# con datos de prueba y contrasenas generadas con openssl.
DB_BIND=

# --- Auth ---
# Distinto al de desarrollo. Cambiarlo invalida todos los tokens emitidos.
JWT_SECRET=
PASSWORD_VIGENCIA_DIAS=90

# --- IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=45000
GEMINI_CHAT_MODEL=
CHAT_LIMITE_DIARIO=20

# --- Entorno ---
# Vacio = production. development monta Swagger en /docs, abierto sin token:
# SOLO en dev. NODE_ENV en este archivo se ignora (lo fija el compose).
API_NODE_ENV=

# NODE_ENV, DB_HOST, DB_PORT y PORT los fija docker-compose.prod.yml.
