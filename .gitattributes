# Archivos que se ejecutan o se leen en Linux (contenedores, VPS): siempre LF,
# aunque el repo se trabaje en Windows con core.autocrlf=true. Un .sh con CRLF
# falla con "/bin/sh^M: bad interpreter".
*.sh        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
# Plantillas que se suben al servidor y que nuevo-tenant.sh lee con sed.
.env.example text eol=lf
